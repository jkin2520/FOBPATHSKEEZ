<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/applyNowButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Job Title -->
            <TextView
                android:id="@+id/jobTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senior Android Developer"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2C2C2C"
                android:layout_marginBottom="8dp" />

            <!-- Company Name -->
            <TextView
                android:id="@+id/companyTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Awesome Tech Co."
                android:textSize="16sp"
                android:textColor="#757575"
                android:layout_marginBottom="4dp" />

            <!-- Location -->
            <TextView
                android:id="@+id/locationTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remote"
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:layout_marginBottom="16dp" />

            <!-- Job Description -->
            <TextView
                android:id="@+id/jobDescriptionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full job description goes here..."
                android:textSize="15sp"
                android:textColor="#444444"
                android:lineSpacingExtra="6dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Apply Now Button -->
    <Button
        android:id="@+id/applyNowButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply Now"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="12dp"
        android:textAllCaps="false"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:elevation="4dp"
        android:layout_marginBottom="12dp" />
</RelativeLayout>
